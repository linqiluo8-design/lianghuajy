# Funcat Docker 环境变量配置
# 复制此文件为 .env 并填入实际值

# ============================================
# 数据库配置
# ============================================

# PostgreSQL
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379
REDIS_MAX_MEMORY=2gb

# InfluxDB (可选)
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=your_influxdb_password_here
INFLUXDB_ADMIN_TOKEN=your_super_secret_token_here
INFLUXDB_PORT=8086

# ============================================
# 数据源API密钥
# ============================================

# Tushare Token (必填)
# 注册地址: https://tushare.pro/register
TUSHARE_TOKEN=your_tushare_token_here

# RQData (可选)
RQDATA_USERNAME=your_rqdata_username
RQDATA_PASSWORD=your_rqdata_password

# ============================================
# 服务配置
# ============================================

# API服务端口
API_PORT=8080

# Nginx端口
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Prometheus端口
PROMETHEUS_PORT=9090

# Grafana配置
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# ============================================
# 应用配置
# ============================================

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 时区
TZ=Asia/Shanghai

# ============================================
# 性能配置
# ============================================

# 选股服务并发数
SELECTOR_WORKERS=100

# 数据库连接池大小
DB_POOL_SIZE=20

# Redis连接池大小
REDIS_POOL_SIZE=10
