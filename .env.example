# ============================================
# Funcat 环境变量配置模板
# ============================================
# 使用方法：
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 修改下方密码和配置
#   3. 启动服务: docker-compose up -d
# ============================================

# ==========================================
# PostgreSQL 数据库配置
# ==========================================
POSTGRES_PASSWORD=funcat_password_change_me
POSTGRES_PORT=5432

# ==========================================
# Redis 缓存配置
# ==========================================
REDIS_PASSWORD=redis_password_change_me
REDIS_PORT=6379
REDIS_MAX_MEMORY=2gb

# ==========================================
# InfluxDB 时序数据库（可选）
# ==========================================
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=influxdb_password_change_me
INFLUXDB_ADMIN_TOKEN=my-super-secret-auth-token
INFLUXDB_PORT=8181
INFLUXDB_LOG_LEVEL=info

# ==========================================
# 实时数据源配置
# ==========================================
# 支持的数据源类型：
#   1. akshare - 免费，延迟3-5秒，稳定性较好，推荐使用 ⭐⭐⭐⭐⭐
#   2. pytdx   - 免费，延迟2-3秒，稳定性最好，基于通达信 ⭐⭐⭐⭐⭐
#   3. tushare - 延迟5-10分钟，适合历史数据分析
REALTIME_DATA_SOURCE=akshare

# 实时数据刷新间隔（秒）
REALTIME_REFRESH_INTERVAL=2

# ==========================================
# Tushare 数据源配置（可选，仅用于历史数据）
# ==========================================
# 注意：Tushare 主要用于历史数据分析，实时性较差（5-10分钟延迟）
# 推荐使用 akshare 或 pytdx 获取实时行情
#
# 注册地址: https://tushare.pro/register
# 获取Token: https://tushare.pro/user/token
# TUSHARE_TOKEN=your_tushare_token_here

# ==========================================
# Web UI 配置
# ==========================================
WEBUI_PORT=8080

# ==========================================
# 选股服务配置
# ==========================================
SELECTOR_INTERVAL=60  # 选股间隔（分钟）

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=info  # debug, info, warn, error

# ==========================================
# Grafana 监控配置（可选）
# ==========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_password_change_me
GRAFANA_PORT=3000

# ==========================================
# Prometheus 监控配置（可选）
# ==========================================
PROMETHEUS_PORT=9090

# ==========================================
# Nginx 反向代理配置（可选）
# ==========================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ==========================================
# 安全建议
# ==========================================
# 1. 生产环境必须修改所有包含 "change_me" 的密码
# 2. 密码建议使用以下命令生成：
#    openssl rand -base64 32
# 3. 不要将 .env 文件提交到 Git 仓库
# 4. 定期更换密码
# ==========================================
