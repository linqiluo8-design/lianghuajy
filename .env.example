# ============================================
# Funcat 环境变量配置模板
# ============================================
# 使用方法：
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 修改下方密码和配置
#   3. 启动服务: docker-compose up -d
# ============================================

# ==========================================
# PostgreSQL 数据库配置
# ==========================================
POSTGRES_PASSWORD=funcat_password_change_me
POSTGRES_PORT=5432

# ==========================================
# Redis 缓存配置
# ==========================================
REDIS_PASSWORD=redis_password_change_me
REDIS_PORT=6379
REDIS_MAX_MEMORY=2gb

# ==========================================
# InfluxDB 时序数据库（可选）
# ==========================================
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=influxdb_password_change_me
INFLUXDB_ADMIN_TOKEN=my-super-secret-auth-token
INFLUXDB_PORT=8181
INFLUXDB_LOG_LEVEL=info

# ==========================================
# Tushare 数据源配置（可选）
# ==========================================
# 注意：本项目支持两种数据源：
#   1. Tushare（在线）- 需要配置Token
#   2. RQAlpha本地数据包（离线）- 无需Token
#
# 如果您已有RQAlpha本地数据包，可以不配置此Token
# 注册地址: https://tushare.pro/register
# 获取Token: https://tushare.pro/user/token
# TUSHARE_TOKEN=your_tushare_token_here

# ==========================================
# Web UI 配置
# ==========================================
WEBUI_PORT=8080

# ==========================================
# 选股服务配置
# ==========================================
SELECTOR_INTERVAL=60  # 选股间隔（分钟）

# ==========================================
# 日志配置
# ==========================================
LOG_LEVEL=info  # debug, info, warn, error

# ==========================================
# Grafana 监控配置（可选）
# ==========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_password_change_me
GRAFANA_PORT=3000

# ==========================================
# Prometheus 监控配置（可选）
# ==========================================
PROMETHEUS_PORT=9090

# ==========================================
# Nginx 反向代理配置（可选）
# ==========================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ==========================================
# 安全建议
# ==========================================
# 1. 生产环境必须修改所有包含 "change_me" 的密码
# 2. 密码建议使用以下命令生成：
#    openssl rand -base64 32
# 3. 不要将 .env 文件提交到 Git 仓库
# 4. 定期更换密码
# ==========================================
